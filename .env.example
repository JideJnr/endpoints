# ── OpenRouter AI (primary provider) ─────────────────────────────────────────
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# openrouter/free  = OpenRouter Free (general purpose)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── App ───────────────────────────────────────────────────────────────────────
PREDICTX_APP_NAME=PredictX Football Stats Agent
PREDICTX_ENV=development
PREDICTX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
PREDICTX_DB_PATH=data/predictx_memory.sqlite3

# ── MongoDB (optional) ────────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB=predictx

# ── AI timeouts ───────────────────────────────────────────────────────────────
PREDICTX_AI_TIMEOUT_SECONDS=30

# ── Web search ────────────────────────────────────────────────────────────────
PREDICTX_WEB_SEARCH_ENABLED=true
PREDICTX_SEARCH_BACKENDS=duckduckgo
PREDICTX_WEB_SEARCH_MAX_RESULTS=3
PREDICTX_WEB_SCRAPE_MAX_CHARS=1500
PREDICTX_WEB_SEARCH_TIMEOUT_SECONDS=4
PREDICTX_WEB_SCRAPE_TIMEOUT_SECONDS=6
