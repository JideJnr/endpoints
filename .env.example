PREDICTX_ENV=production
PREDICTX_CORS_ORIGINS=https://your-mobile-web-app.example.com,http://localhost:5173
PREDICTX_DB_PATH=/var/data/predictx_memory.sqlite3

# MongoDB archive for finished matches.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=Cluster0
MONGODB_DB=predictx

# AI brain: use huggingface on Render, ollama locally, or auto fallback.
PREDICTX_AI_PROVIDER=huggingface
HF_TOKEN=your_hugging_face_token
PREDICTX_HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
PREDICTX_AI_TIMEOUT_SECONDS=15

# Local development only.
PREDICTX_OLLAMA_URL=http://localhost:11434/api/chat
PREDICTX_AI_MODEL=llama3.2:3b

# Web context search.
PREDICTX_WEB_SEARCH_ENABLED=true
PREDICTX_SEARCH_BACKENDS=duckduckgo
PREDICTX_WEB_SEARCH_MAX_RESULTS=3
PREDICTX_WEB_SCRAPE_MAX_CHARS=1500
PREDICTX_WEB_SEARCH_TIMEOUT_SECONDS=4
PREDICTX_WEB_SCRAPE_TIMEOUT_SECONDS=6

# ── SportyBet anti-block (optional) ──────────────────────────────────────────
# If Render's datacenter IP keeps getting 403'd by SportyBet even after
# TLS fingerprint rotation, route requests through a residential proxy.
# Residential proxy services: Webshare, Oxylabs, Bright Data, Smartproxy.
# Format: http://username:password@proxy-host:port
# Leave blank to use direct connection (default).
# SPORTYBET_PROXY=http://user:pass@residential-proxy.example.com:8080
# Optional: SportyBet endpoint that creates a share code from a prepared slip.
# The app calls it with ?throwInvalidEvent=true and never invents a code locally.
# SPORTYBET_SHARE_CODE_URL=https://www.sportybet.com/api/ng/<provider-share-code-endpoint>

# ── Keep-alive (Render free tier) ────────────────────────────────────────────
# The scheduler pings this URL every 10 min to prevent the dyno sleeping.
# Render sets RENDER_EXTERNAL_URL automatically — only set this if it doesn't.
# PREDICTX_SELF_URL=https://endpoints-dtfx.onrender.com

# Groq LLM (optional — enables the 10-step reasoning agent)
# GROQ_API_KEY=your_groq_api_key
