# ── DeepSeek AI (primary provider) ───────────────────────────────────────────
# Get your API key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# deepseek-chat  = DeepSeek-V3 (cheapest, fastest, recommended)
# deepseek-reasoner = DeepSeek-R1 (slower, deeper reasoning)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── App ───────────────────────────────────────────────────────────────────────
PREDICTX_APP_NAME=PredictX Football Stats Agent
PREDICTX_ENV=development
PREDICTX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
PREDICTX_DB_PATH=data/predictx_memory.sqlite3

# ── MongoDB (optional) ────────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB=predictx

# ── AI timeouts ───────────────────────────────────────────────────────────────
PREDICTX_AI_TIMEOUT_SECONDS=30

# ── Web search ────────────────────────────────────────────────────────────────
PREDICTX_WEB_SEARCH_ENABLED=true
PREDICTX_SEARCH_BACKENDS=duckduckgo
PREDICTX_WEB_SEARCH_MAX_RESULTS=3
PREDICTX_WEB_SCRAPE_MAX_CHARS=1500
PREDICTX_WEB_SEARCH_TIMEOUT_SECONDS=4
PREDICTX_WEB_SCRAPE_TIMEOUT_SECONDS=6
